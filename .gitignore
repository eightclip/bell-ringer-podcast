node_modules/

# Secrets. The bare name is not enough: an editor or a hurried `cp` will
# happily make .env.bak, .env.local, .env.save — and a single one of those
# committed is every credential in the project, permanently, in git history.
.env
.env.*
!.env.example

# Build output: audio, artwork, manifests, and the JSON stages. Large,
# regenerable, and specific to one family's week.
#
# This used to carry `!build/*/*/scripts.json` and three siblings, on the theory
# that the JSON stages are a cheap reviewable record of what the model wrote.
# They never worked — git cannot re-include a file whose parent directory is
# excluded, so `build/` won every time. Removed rather than repaired, because
# repairing them is the wrong direction: scripts.json is the episode text
# written for one named child, and a rule that quietly makes it committable is
# a rule that eventually commits it.
build/

# Media. Never commit music or audio you licensed — your licence almost
# certainly does not cover redistribution from a public repo.
*.mp3
*.wav
*.m4a
# The one exception: a sample episode built entirely from the invented example
# curriculum, with no music and no photography, so there is nothing in it that
# belongs to anyone else.
!.github/media/sample-episode.mp3

# Your own curriculum. Ships as an example only; keep real school documents,
# which identify a real child and a real teacher, out of the repo.
plans/*.pdf
plans/*-year.json
plans/*-blocks.json
!plans/example-year.json

# Generated artwork
assets/cover-*.jpg
assets/_type.png

.DS_Store
.vercel/
site/.next/
site/node_modules/
