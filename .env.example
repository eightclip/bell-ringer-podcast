# Copy to .env and fill in. Never commit the result — .gitignore covers
# .env and every .env.* variant, because a stray .env.bak is how credentials
# actually leak.

# --- Identity -------------------------------------------------------------
SHOW_BRAND_NAME=Bell Ringer
SHOW_AUTHOR=Your Name
SITE_URL=http://localhost:3000

# Who the PARENT voice is, in the writer's own words. Goes into the brief
# verbatim and is never spoken aloud: 'their own father', 'their mum',
# 'their uncle Ray', 'the parent driving them to school'.
PARENT_IS=the parent driving them to school
# Goes into <itunes:owner> in the feed. Apple requires it to submit a show;
# leave it blank for an unlisted family feed and no address is published.
OWNER_EMAIL=

# --- Names -----------------------------------------------------------------
# Names that must never be spoken, comma separated. Your child's, their
# friends', a teacher's — whatever should not end up in audio on a public
# bucket.
#
# This is a control, not a preference. The writer is told not to use names, and
# on 2026-08-17 it used one anyway and two episodes shipped opening with it.
# pipeline/prosody.mjs now strips them from every segment before anything is
# stored, so scripts.json is clean and no later stage has to remember.
#
# LEFT EMPTY THERE IS NO GATE. It is a list of strings to look for; with no
# strings it finds nothing. Fill it in before you render anything real.
#
# The names live here and never in the repo, which is what lets the guard be
# public while the thing it guards against is not.
PRIVATE_NAMES=
# What a removed name is replaced with when one slips through mid-sentence.
# Normally leave this blank: it comes from SHOWS.<id>.listener.term in
# config/show.mjs so the writer and the gate agree. Set it only to run
# `npm run prosody` over an old scripts.json with no show config to hand.
LISTENER_TERM=

# Emits <itunes:block>Yes</itunes:block> when false, which asks Apple and every
# directory that mirrors it NOT to list the show. Read docs/SECURITY.md before
# setting this to true — it is not cleanly reversible, and if the show is built
# from a real child's timetable it probably should stay false forever.
SHOW_LISTED=false

# --- Research + scripts ---------------------------------------------------
# https://console.anthropic.com
ANTHROPIC_API_KEY=
# Verification is quote-matching, not reasoning, so it runs on the cheap model.
# This one setting is the difference between ~$9 and ~$0.40 per week.
VERIFY_MODEL=claude-haiku-4-5
# Hard cap on claims per week; each costs a page re-read to verify.
MAX_CLAIMS=40

# --- Voice ----------------------------------------------------------------
# The show has two roles: PARENT (cold open, welcome, outro) and NARRATOR
# (the two acts). They are named for the job, not for who fills it.
#
#   full-stock  Both roles on OpenAI. One key, ~$0.95/week, and the default.
#   hybrid      Your cloned voice as the parent, OpenAI narrates. ~$1.35/week.
#   duo-hume    Two Hume voices.
#   full-hume   Everything on Hume. Roughly 3.5x full-stock.
#
# Measured, not guessed: Hume bills ~$0.12/1k characters and OpenAI ~$0.025/1k.
# A five-episode week is about 38k characters. Voice is the cheapest stage of
# the pipeline either way — research costs roughly ten times as much — so pick
# the one that sounds right rather than the one that saves forty cents.
VOICE_MODE=full-stock

# https://platform.openai.com
# Voices: alloy ash ballad coral echo fable nova onyx sage shimmer
# 'sage' and 'ballad' read calmest; 'nova' and 'shimmer' are brighter.
OPENAI_API_KEY=
OPENAI_VOICE=sage
# Optional: give the narrator a different stock voice from the parent.
OPENAI_VOICE_NARRATOR=

# Only needed for hybrid / duo-hume / full-hume. https://platform.hume.ai
# PROVIDER is CUSTOM_VOICE for a clone you made, HUME_AI for a library voice.
# Sending the wrong one returns a 404 that reads like the voice was deleted.
HUME_API_KEY=
HUME_VOICE_PARENT=
HUME_VOICE_PARENT_PROVIDER=CUSTOM_VOICE
HUME_VOICE_NARRATOR=
HUME_VOICE_NARRATOR_PROVIDER=HUME_AI

# --- Artwork (optional) ---------------------------------------------------
# https://unsplash.com/developers — free tier is 50 req/hr; this uses ~6/week.
# Without it, episodes get a plain colour-wash cover instead of a photo.
UNSPLASH_ACCESS_KEY=

# --- Storage + feed (not needed for `npm run demo`) -----------------------
# Cloudflare R2: zero egress fees, which is the whole reason this isn't S3.
R2_ACCOUNT_ID=
R2_BUCKET=
# Optional locally — without them the pipeline shells out to `wrangler` and
# uses your OAuth login. REQUIRED in GitHub Actions.
# Cloudflare dashboard -> R2 -> Manage R2 API Tokens.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Your public r2.dev URL, or a custom domain bound to the bucket. Prefer the
# custom domain: r2.dev is rate-limited and awkward to migrate off later.
R2_PUBLIC_BASE=

# The feed lives at an unguessable path so the show stays unlisted.
# Generate with:  openssl rand -hex 16
# Understand what this does and does not protect: docs/SECURITY.md
FEED_TOKEN=

# --- Ingest site ----------------------------------------------------------
# Shared secret for the paste-in page. Generate with: openssl rand -hex 16
# Use a generated value, not a password you use anywhere else.
INGEST_PASSWORD=
